			"label": "Backend API Smoke Test",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const http=require('http');const child=require('child_process').spawn(process.execPath,['backend/server.js'],{cwd:process.cwd(),stdio:'ignore'});setTimeout(()=>{http.get('http://127.0.0.1:5000/api/health',r=>{console.log('health status',r.statusCode);http.get('http://127.0.0.1:5000/api/content',x=>{console.log('public content status',x.statusCode);http.request({host:'127.0.0.1',port:5000,path:'/api/content',method:'POST'},y=>{console.log('unauthenticated write status',y.statusCode);child.kill();}).end();});}).on('error',e=>{console.error(e.message);child.kill();process.exitCode=1;});},1500)"
			],
			"problemMatcher": [],
			"group": "test"
		},
